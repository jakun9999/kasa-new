# Environment variables for the application

# URL publique du front (sitemap.xml, liens absolus SEO)
# Local : http://localhost:8080 — Prod : https://kasa.demo.cassiandev.net
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# API URL (Express.js backend)
# Local : http://localhost:3000 — Prod : https://api.kasa.demo.cassiandev.net
NEXT_PUBLIC_API_URL=http://localhost:3000

# JWT Secret for authentication (identique au backend — ne pas committer la vraie valeur)
JWT_SECRET="Change me before deploying"
